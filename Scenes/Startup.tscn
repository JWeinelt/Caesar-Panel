[sub_resource type="GDScript" id=3]
script/source = "extends Control

func _ready():
	GE.connect(\"loaded_weather\", self, \"_on_got_weather\")
	GE.request_location()
	get_tree().get_root().set_transparent_background(true)
	OS.window_borderless = true


func _on_got_weather(data):
	print(data)
	var greet = GE.get_greeting_from_time(data.current.time)
	$Bg/Greeting.text = greet
	var to_load = \"res://Assets/Backgrounds/non_blur/bg2.png\"
	
	if float(data.current.temperature_2m) < 5.0: to_load = \"res://Assets/Backgrounds/non_blur/bg35.png\"
	var weather_code = int(data.current.weather_code)
	match weather_code:
		0: to_load = \"res://Assets/Backgrounds/non_blur/bg29.png\"
		1: to_load = \"res://Assets/Backgrounds/non_blur/bg34.png\"
		2: to_load = \"res://Assets/Backgrounds/non_blur/bg30.png\"
		3: to_load = \"res://Assets/Backgrounds/non_blur/bg9.png\"
		
	if weather_code in range(45, 86): to_load = \"res://Assets/Backgrounds/non_blur/bg40.png\"
	
	$Bg.texture = load(to_load)
	$FX.play(\"auto\")


func _on_FX_animation_finished(anim_name):
	get_tree().change_scene(\"res://Scenes/Login.tscn\")
"

