[sub_resource type="GDScript" id=1]
script/source = "extends Control


func _ready():
	if GE.enable_cloud:
# warning-ignore:return_value_discarded
		GE.connect(\"services_got\", self, \"_on_services_received\")
# warning-ignore:return_value_discarded
		GE.connect(\"tasks_got\", self, \"_on_tasks_received\")
# warning-ignore:return_value_discarded
		GE.connect(\"groups_got\", self, \"_on_groups_received\")
		GE.get_services()
		GE.get_tasks()
		GE.get_groups()
	else:
		print(\"CloudNET not enabled, skipping data fetching.\")


func _on_services_received(data):
	var amount = data.services.size()
	$Overview/Servers/Amount.text = str(amount)
	
	for i in data.services:
		var entry = load(\"res://Scenes/Objects/ServiceEntry.tscn\").instance()
		entry.connect(\"clicked\", self, \"_on_service_clicked\")
		$Parts/CloudNET/Tabs/Services/ServiceList/Services.add_child(entry)
		entry.setup(i)


func _on_tasks_received(data):
	var amount = data.tasks.size()
	$Overview/Tasks/Amount.text = str(amount)
	
	for i in data.tasks:
		var entry = load(\"res://Scenes/Objects/TaskEntry.tscn\").instance()
		entry.connect(\"clicked\", self, \"_on_task_clicked\")
		$Parts/CloudNET/Tabs/Tasks/TaskList/Tasks.add_child(entry)
		entry.setup(i)


func _on_groups_received(data):
	$Parts/CloudNET/Tabs/Groups.setup(data)


func _on_service_clicked(service):
	$Parts/CloudNET/Tabs/Services/ServiceDetails.show()
	var task = service.configuration.serviceId.taskName
	var s = task + service.configuration.serviceId.nameSplitter
	s += str(service.configuration.serviceId.taskServiceId)
	
	$Parts/CloudNET/Tabs/Services/ServiceDetails/Info.bbcode_text = \"\"\"
	
	[b]%s[/b]
	Task: %s
	ID: %s
	Address: %s:%s
	Online since: %s
	\"\"\" % [
		s,
		task,
		service.configuration.serviceId.uniqueId.substr(10) + \"...\",
		service.address.host,
		str(service.address.port),
		readable_connected_time(service.connectedTime)
	]
	
	for i in service.properties.Players:
		var p = load(\"res://Scenes/Objects/PlayerFace.tscn\").instance()
		p.id = i.uniqueId
		p.data = i
		$Parts/CloudNET/Tabs/Services/ServiceDetails/DropDown/PlayerContainer.add_child(p)


func _on_task_clicked(data):
	$Parts/CloudNET/Tabs/Tasks/TaskDetail.setup(data)


func readable_connected_time(ms_timestamp: int) -> String:
# warning-ignore:integer_division
	var unix_time = int(ms_timestamp / 1000)

	var dt = OS.get_datetime_from_unix_time(unix_time)

	return \"%02d. %02d. %04d %02d:%02d:%02d\" % [
		dt.day, dt.month, dt.year,
		dt.hour, dt.minute, dt.second
	]
"

