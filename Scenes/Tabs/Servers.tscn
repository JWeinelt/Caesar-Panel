[sub_resource type="GDScript" id=16]
script/source = "extends Tabs

func setup(json):
	var i = 0
	for group in json.groups:
		if group.templates == []: continue
		var inst = load(\"res://Scenes/Objects/GroupTab.tscn\").instance()
		$GroupContainer.add_child(inst)
		$GroupContainer.set_tab_title(i, group.get(\"name\"))
		i += 1
		inst.setup(group)
"

