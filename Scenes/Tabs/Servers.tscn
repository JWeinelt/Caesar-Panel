[sub_resource type="GDScript" id=13]
script/source = "extends Control


func _ready():
	$MainTaskConfig.hide()
	$GroupConfig.hide()
	$SmartConfig.hide()
	$TemplateConfig.hide()


func setup(data):
	$MainTaskConfig.show()
	$GroupConfig.hide()
	$SmartConfig.hide()
	$TemplateConfig.hide()
	
	$MainTaskConfig/Memory.value = data.processConfiguration.maxHeapMemorySize
	$MainTaskConfig/StaticService.pressed  = data.staticServices
	$MainTaskConfig/Maintenance.pressed  = data.maintenance
	$MainTaskConfig/DisableIPRewrite.pressed  = data.disableIpRewrite
	$MainTaskConfig/AutoDelete.pressed  = data.autoDeleteOnStop
	
	$MainTaskConfig/MinService.value = data.minServiceCount
	
	if not data.properties.has(\"smartConfig\"): return
	# Smart config
	$SmartConfig/EnableSmartConfig.pressed = data.properties.smartConfig.enabled
	if not data.properties.smartConfig.enabled: update_smart(false)
	$SmartConfig/Priority.value = data.properties.smartConfig.priority
	$SmartConfig/PrepServices.value = data.properties.smartConfig.preparedServices
	$SmartConfig/MaxServices.value = data.properties.smartConfig.maxServices
	$SmartConfig/Split.pressed = data.properties.smartConfig.splitLogicallyOverNodes
	$SmartConfig/AutostopTime.value = data.properties.smartConfig.autoStopTimeByUnusedServiceInSeconds
	$SmartConfig/PercentStop.value = data.properties.smartConfig.percentOfPlayersToCheckShouldStopTheService
	$SmartConfig/PercentStart.value = data.properties.smartConfig.percentOfPlayersForANewServiceByInstance


func update_smart(vis):
	$SmartConfig/Priority.visible = vis
	$SmartConfig/MaxServices.visible = vis
	$SmartConfig/Split.visible = vis
	$SmartConfig/AutostopTime.visible = vis
	$SmartConfig/PercentStart.visible = vis
	$SmartConfig/PercentStop.visible = vis
	$SmartConfig/TemplateInstaller.visible = vis


func _on_GroupConfig_pressed():
	$GroupConfig.show()
	$SmartConfig.hide()
	$TemplateConfig.hide()


func _on_SmartConfig_pressed():
	$SmartConfig.show()
	$GroupConfig.hide()
	$TemplateConfig.hide()


func _on_TemplateConfig_pressed():
	$TemplateConfig.show()
	$GroupConfig.hide()
	$SmartConfig.hide()


func _on_Memory_value_changed(value):
	$MainTaskConfig/Memory/Value.text = str(value)
"

