script/source = "extends Tabs

var opened = false

func _ready():
# warning-ignore:return_value_discarded
	MarketDataFetcher.connect(\"plugins_got\", self, \"_on_plugins_fetched\")


func _on_Marketplace_tab_clicked(tab):
	if tab == 2:
		opened = true
		MarketDataFetcher.fetch_plugins()


func _on_plugins_fetched(data):
	for i in data:
		pass
"

