[sub_resource type="GDScript" id=12]
script/source = "extends Control

func _ready():
	get_tree().get_root().set_transparent_background(true)
	OS.window_borderless = true
	
	$Screen2/Info.get_v_scroll().connect(\"value_changed\", self, \"_on_rich_val_change\")
	
	GE.connect(\"caesar_checked_connection\", self, \"_on_connection_check\")
	GE.connect(\"code_validated\", self, \"_on_code_validation\")


func _on_StartSetup_pressed():
	$FX.play(\"page1\")

func _on_rich_val_change(val: float):
	if val == 498:
		$Screen2/Page2Next.disabled = false


func _on_Page2Next_pressed():
	$FX.play(\"page2\")


func _on_AddressName_text_entered(new_text):
	var port := 49800
	if $Screen3/UseCustomPort.pressed: port = $Screen3/UseCustomPort/PortNumber.value
	GE.check_connection_caesar(new_text, $Screen3/UseSSL.pressed, port)
	$Screen3/Loader.show_loading(30)


func _on_connection_check(setup: bool):
	$Screen3/Loader.end_loading()
	GE.save_config()
	if setup:
		$FX.play(\"page3\")
	else:
		get_tree().change_scene(\"res://Scenes/Login.tscn\")


func _on_VerifyDigits_text_entered(new_text):
	GE.request_setup_code_validation(int(new_text))


func _on_code_validation(valid: bool):
	if valid: get_tree().change_scene(\"res://Scenes/Login.tscn\")
	else: OS.alert(\"The provided code is not valid\", \"Code invalid\")
	
	
"

