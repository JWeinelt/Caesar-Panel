[sub_resource type="GDScript" id=16]
script/source = "extends Control

var click_pos = Vector2.ZERO
var can_drag = false
var can_resize = false

var resizing: bool = false
var initial_mouse_y: int = 0
var initial_height: int = 0


func _ready():
# warning-ignore:return_value_discarded
	connect(\"mouse_entered\", self, \"_on_mouse_entered\")
# warning-ignore:return_value_discarded
	connect(\"mouse_exited\", self, \"_on_mouse_exited\")
	
# warning-ignore:return_value_discarded
	ClientLinkSocket.connect(\"dc_voice_update\", self, \"_on_voice_update\")
# warning-ignore:return_value_discarded
	ClientLinkSocket.connect(\"dc_code_got\", self, \"_on_code_got\")
# warning-ignore:return_value_discarded
	ClientLinkSocket.connect(\"dc_link_success\", self, \"_on_dc_link_success\")


func _process(_delta):
	if Input.is_action_just_pressed(\"click\") and can_drag:
		click_pos = get_local_mouse_position()
	if Input.is_action_pressed(\"click\") and can_drag:
		OS.set_window_position(
			OS.window_position +
			get_global_mouse_position() - 
			click_pos
		)
	
	
	if resizing:
		var mouse_y = get_local_mouse_position().y
		var new_height = initial_height + (mouse_y - initial_mouse_y)
		
		new_height = max(new_height, 50)
	

func _on_mouse_entered():
	can_drag = true

func _on_mouse_exited():
	can_drag = false


func _on_voice_update(data):
	$Discord.show()
	if data.linked: $Discord/Connect.hide()
	if data.linked: $Discord/Status.texture = load(\"res://Assets/Misc/node_ready.png\")
	else: $Discord/Status.texture = load(\"res://Assets/Misc/node_disconnected.png\")
	if data.channel != \"\":
		$Discord/Info.text = \"Connected - \" + data.channel
	else:
		$Discord/Info.text = \"Not Connected\"


func _on_code_got(code):
	$Discord/VerifyWindow.popup()
	$Discord/VerifyWindow/Layout/Code.text = str(code)


func _on_ConnectLayer_gui_input(event):
	if event is InputEventMouseButton:
		if event.pressed and event.button_index == BUTTON_LEFT:
			ClientLinkSocket.send_code_request()


func _on_dc_link_success():
	$Discord/VerifyWindow.hide()
"

