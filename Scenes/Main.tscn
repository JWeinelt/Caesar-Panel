[sub_resource type="GDScript" id=4]
script/source = "extends Control

var scenes = []

func _ready():
	if GE.cs_settings.clientSettings.blur_background:
		update_bg_blur(GE.cs_settings.clientSettings.blur_rate)
	else: update_bg_blur(0)
	if GE.cs_settings.clientSettings.useBackgroundImage:
		change_bg_image(GE.cs_settings.clientSettings.used_background)
		update_background_mode(true)
		GE.emit_signal(\"background_image_use_toggle\", true)
		print(\"Changed bg according to settings\")
	
	for i in $Sidebar/SidebarList.get_children():
		i.connect(\"pressed\", self, \"_on_sidebar_click\")
	
	$SettingsScreen.hide()
	
	provide_pages()
	_on_sidebar_click(\"Dashboard\")
# warning-ignore:return_value_discarded
	GE.connect(\"server_config_loaded\", self, \"_on_server_config_loaded\")
# warning-ignore:return_value_discarded
	GE.connect(\"config_server_change_ok\", self, \"_on_server_config_changed\")
# warning-ignore:return_value_discarded
	GE.connect(\"server_config_load_fail\", self, \"_on_server_config_load_fail\")
# warning-ignore:return_value_discarded
	JsonDataParser.connect(\"component_value_change\", self, \"_on_config_value_change\")
	
	
	var f = Directory.new()
	if f.open(\"res://Assets/Backgrounds/non_blur\") == OK:
		f.list_dir_begin(true, true)
		var file_name = f.get_next()
		
		while file_name != \"\":
			if !f.current_is_dir() and file_name.ends_with(\".png\"):
				$SettingsScreen/ClientSettings/Design/BgSelector.add_item(file_name.replace(\".png\", \"\"))
			file_name = f.get_next()
			
		f.list_dir_end()
	else:
		print(\"Could not load background images\")
	
	$Version.text = \"v\" + GE.client_version


func provide_pages():
	for i in $Sidebar/SidebarList.get_children():
		var scene: PackedScene = i.to_load
		var n = scene.instance()
		$Main.add_child(n)
		n.hide()
		scenes.append(scene)


func show_settings():
	$SettingsScreen.show()
	$Main.hide()
	$SettingsScreen/ServerSettings/Loader.show_loading(30)
	#GE.get_server_config()



func _on_Exit_pressed():
	Worker.send_message(\"stop-caesar\")


func _on_sidebar_click(entry):
	for i in $Main.get_children():
		i.hide()
	
	var idx = 0
	for j in $Sidebar/SidebarList.get_children(): j.select(false)
	
	for j in $Sidebar/SidebarList.get_children():
		if j.entry_name == entry:
			$Main.get_child(idx).show()
			j.select(true)
			return
		idx += 1
	
	print(\"No scene found\")


func _on_server_config_loaded(data):
	JsonDataParser.parse(data, \"config\", $SettingsScreen/ServerSettings/List/List)
	$SettingsScreen/ServerSettings/Loader.end_loading()


func _on_server_config_load_fail():
	$SettingsScreen/ServerSettings/Loader.end_loading()
	$SettingsScreen/ServerSettings/Error.show()


func _on_Settings_pressed():
	if $SettingsScreen.visible:
		$SettingsScreen.hide()
		$Main.show()
		return
	show_settings()
	GE.get_server_config()


func _on_SaveSettings_pressed():
	for i in $SettingsScreen/ServerSettings/List/List.get_children():
		if not i.has_method(\"value\"): continue
		GE.send_config_change_indiv(i.key, i.value())
		$SettingsScreen/ServerSettings/ChangeLoader.show_loading(30)


func _on_server_config_changed():
	$SettingsScreen/ServerSettings/SaveSettings.disabled = true
	$SettingsScreen/ServerSettings/ChangeLoader.end_loading()


# warning-ignore:unused_argument
func _on_config_value_change(value, data_name):
	if data_name != \"config\": return
	$SettingsScreen/ServerSettings/SaveSettings.disabled = false


func _on_BlurRate_value_changed(value):
	var mat: ShaderMaterial = $SettingsScreen/ClientSettings/Design/Preview.material
	mat.set(\"shader_param/blur_size\", value)



func update_background_mode(use_image: bool):
	if use_image: $BgFX.play(\"change\")
	else: $BgFX.play_backwards(\"change\")


func change_bg_image(id: int):
	print(\"Loading background with id \" + str(id))
	var path = \"res://Assets/Backgrounds/non_blur/bg%s.png\" % id
	$BgImage.get(\"custom_styles/panel\").texture = load(path)


func update_bg_blur(blur: float):
	var shader_material := $BgImage.material as ShaderMaterial
	shader_material.set_shader_param(\"blur_size\", blur)


func _on_CreateConn_pressed():
	GE.create_connection(\"SomeServer-1\", \"127.0.0.1\", \"25565\", true)
"

