[sub_resource type="GDScript" id=4]
script/source = "extends Control

var scenes = []

func _ready():
	get_tree().get_root().set_transparent_background(true)
	OS.window_borderless = true
	
	for i in $Sidebar/SidebarList.get_children():
		i.connect(\"pressed\", self, \"_on_sidebar_click\")
	
	provide_pages()
	_on_sidebar_click(\"Dashboard\")


func provide_pages():
	for i in $Sidebar/SidebarList.get_children():
		var scene: PackedScene = i.to_load
		var n = scene.instance()
		$Main.add_child(n)
		n.hide()
		scenes.append(scene)


func _on_Exit_pressed():
	get_tree().quit()


func _on_sidebar_click(entry):
	for i in $Main.get_children():
		i.hide()
	
	var idx = 0
	for j in $Sidebar/SidebarList.get_children():
		if j.entry_name == entry:
			print(\"found\")
			print(scenes[idx].resource_path)
			$Main.get_child(idx).show()
			return
		idx += 1
	
	print(\"No scene found\")
"

