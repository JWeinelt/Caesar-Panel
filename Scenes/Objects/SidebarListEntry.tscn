[ext_resource path="res://Assets/sidebar/dashboard.png" type="Texture" id=1]

[sub_resource type="GDScript" id=2]
script/source = "extends Control

signal pressed(entry_name)

export(String) var entry_name
export(String) var icon_path

func _ready():
	$Name.text = entry_name
	var style = StyleBoxTexture.new()
	style.texture = load(\"res://Assets/sidebar/%s.png\" % icon_path)
	$Icon.set(\"custom_styles/panel\", style)

func _on_Overlay_mouse_entered():
	$FX.play(\"fade_in\")


func _on_Overlay_mouse_exited():
	$FX.play(\"fade_out\")


func _on_Overlay_gui_input(event):
	pass # Replace with function body.
"

