[sub_resource type="GDScript" id=2]
script/source = "extends Tabs

func setup(json):
	for t in json.templates:
		var entry = load(\"res://Scenes/Objects/iObj/TemplateEntry.tscn\").instance()
		entry.connect(\"double_click\", self, \"_on_template_dk\")
		entry.connect(\"selected\", self, \"_on_template_selected\")
		$Templates/TemplateList/List.add_child(entry)
		entry.setup(t)


func _on_template_dk(node):
	pass


func _on_template_selected(node):
	for i in $Templates/TemplateList/List.get_children(): node.selection(false)
	node.selection(true)
"

