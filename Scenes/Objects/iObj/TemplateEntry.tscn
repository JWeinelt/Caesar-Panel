[ext_resource path="res://Assets/fonts/segoe-ui.ttf" type="DynamicFontData" id=1]

[sub_resource type="GDScript" id=2]
script/source = "extends Control

signal selected(node)
signal double_click(node)

var data

func setup(json):
	$Name.text = json.get(\"name\")
	data = json


func selection(sel):
	$Bg.visible = sel


func _on_Name_gui_input(event):
	if event is InputEventMouseButton:
		print(\"click\")
		if event.doubleclick:
			emit_signal(\"double_click\", self)
		if event.pressed: emit_signal(\"selected\", self)
"

