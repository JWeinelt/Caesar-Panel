[sub_resource type="GDScript" id=1]
script/source = "extends Control

signal mark_deleted(id)

var data = {}

func setup(newData):
	data = newData
	
	var icon = load(\"res://Assets/icons/%s.png\" % data.PunishmentName.to_lower())
	$Icon.texture = icon


func _on_DeleteLayer_gui_input(event):
	if event is InputEventMouseButton:
		if event.pressed and event.button_index == BUTTON_LEFT:
			emit_signal(\"mark_deleted\", data.RecordID)
"

