[sub_resource type="GDScript" id=7]
script/source = "extends Control

func setup(message, time):
	$Message.bbcode_text = message
	$Time.text = str(format_timestamp(time))


func format_timestamp(timestamp_ms: int) -> String:
	var timestamp_sec = timestamp_ms / 1000

	var datetime = OS.get_datetime_from_unix_time(timestamp_sec)

	return \"%02d.%02d.%04d %02d:%02d:%02d\" % [
		datetime.day,
		datetime.month,
		datetime.year,
		datetime.hour,
		datetime.minute,
		datetime.second
	]
"

