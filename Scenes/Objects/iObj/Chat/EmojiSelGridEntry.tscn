[sub_resource type="GDScript" id=1]
script/source = "extends Control

signal emoji_selected(sheet_id, emj_id)

var sheet_id
var emoji_frame


func _ready():
	$CanvasLayer/Info.hide()


func setup(sheet, mji):
	sheet_id = sheet
	emoji_frame = mji
	$Img.texture = load(EmojiWrapper.get_sheet_path(sheet))
	$Img.hframes = EmojiWrapper.get_sheet_size(sheet).x
	$Img.vframes = EmojiWrapper.get_sheet_size(sheet).y
	$Img.frame = mji


func _on_Img_mouse_entered():
	#$CanvasLayer/Info.show()
	pass


func _on_Img_mouse_exited():
	$CanvasLayer/Info.hide()


func _on_Mouse_gui_input(event):
	if event is InputEventMouseButton:
		if event.pressed and event.button_index == BUTTON_LEFT:
			emit_signal(\"emoji_selected\", sheet_id, emoji_frame)
"

