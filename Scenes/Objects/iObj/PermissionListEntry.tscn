[ext_resource path="res://Assets/fonts/CascadiaMono.ttf" type="DynamicFontData" id=1]

[sub_resource type="GDScript" id=2]
script/source = "extends Control

signal remove_perm(perm_name)
signal perm_selected(perm_name)

export(bool) var selectable = false

var permission_name


func _ready():
	if selectable:
		$Layout.show()
		$Remove.hide()
	else:
		$Layout.hide()
		$Remove.show()


func setup(perm):
	permission_name = perm
	$Name.text = permission_name
	$Layout.hint_tooltip = permission_name
	$Name.hint_tooltip = permission_name


func _on_Remove_pressed():
	emit_signal(\"remove_perm\", permission_name)


func _on_Layout_gui_input(event):
	if event is InputEventMouseButton:
		if event.button_index == BUTTON_LEFT and event.pressed:
			emit_signal(\"perm_selected\", permission_name)
"

