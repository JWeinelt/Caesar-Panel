[application]

config/name="CaesarPanelUniversal"
config/use_custom_user_dir=true
config/custom_user_dir_name="Caesar"
run/low_processor_mode=true
boot_splash/show_image=false
boot_splash/bg_color=Color( 0.0509804, 0.0392157, 0.0392157, 0.0392157 )
config/icon="res://Assets/logo.png"
config/windows_native_icon="res://Assets/favicon.ico"
config/auto_accept_quit=false
config/quit_on_go_back=false

[autoload]

CN="*res://Scripts/CloudNET.gd"
GE="*res://Scripts/GlobalEngine.tscn"

[display]

window/size/borderless=true
window/per_pixel_transparency/allowed=true
window/per_pixel_transparency/enabled=true
window/energy_saving/keep_screen_on=false
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/SmoothScroll/plugin.cfg", "res://addons/easy_charts/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0.301961, 0.301961, 0.301961, 0 )
environment/default_environment="res://default_env.tres"
